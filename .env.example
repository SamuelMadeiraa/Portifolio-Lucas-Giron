# ═══ Configuração do servidor (VPS / Docker) ═══
# Copie para .env e preencha:   cp .env.example .env

# Seu domínio, já apontando (registro A) para o IP da VPS.
# Para testar só pelo IP, sem domínio: DOMAIN=:80  (e COOKIE_SECURE=false abaixo)
DOMAIN=seudominio.com.br

# Login do painel /admin
ADMIN_USER=lucas
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Chave para assinar a sessão. Gere uma com:  openssl rand -hex 32
SESSION_SECRET=

# Tamanho máximo de cada arquivo enviado pelo painel (MB)
MAX_UPLOAD_MB=500

# Só use false para testar sem HTTPS (acesso pelo IP). Em produção, deixe comentado.
# COOKIE_SECURE=false
